{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "script.js", "use": "@vercel/static" },
    { "src": "style.css", "use": "@vercel/static" },
    { "src": "api/run.py", "use": "@vercel/python" },
    { "src": "api/export_google_sheets.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/run", "dest": "api/run.py" },
    { "src": "/api/export_google_sheets", "dest": "api/export_google_sheets.py" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
